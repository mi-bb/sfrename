# Removes every file listed in install_manifest.txt, the replacement for the
# Autotools "make uninstall" target.  Configured by CMakeLists.txt.

set(MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")

if(NOT EXISTS "${MANIFEST}")
    message(STATUS "No \"${MANIFEST}\": nothing was installed from this build directory, nothing to uninstall.")
    return()
endif()

file(STRINGS "${MANIFEST}" files)

foreach(file ${files})
    message(STATUS "Uninstalling \"$ENV{DESTDIR}${file}\"")
    if(EXISTS "$ENV{DESTDIR}${file}" OR IS_SYMLINK "$ENV{DESTDIR}${file}")
        file(REMOVE "$ENV{DESTDIR}${file}")
    else()
        message(STATUS "File \"$ENV{DESTDIR}${file}\" does not exist.")
    endif()
endforeach()
